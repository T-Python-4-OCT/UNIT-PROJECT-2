<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">{% for url in urls %}
  <url>
    <loc>{{ url.loc }}</loc>
    <xhtml:link rel="alternate" hreflang="en" href="{{ url.alternates.en }}"/>
    <xhtml:link rel="alternate" hreflang="ar" href="{{ url.alternates.ar }}"/>
  </url>{% endfor %}
</urlset>
