
# Your OpenRouter key (from https://openrouter.ai/keys). Leave empty to use local rules only.
OPENROUTER_API_KEY=

# The AI model used for the detector (any OpenRouter model that supports JSON answers)
OPENROUTER_MODEL=openai/gpt-4o-mini

DJANGO_SECRET_KEY=change-me-to-any-long-random-text
DJANGO_DEBUG=True
