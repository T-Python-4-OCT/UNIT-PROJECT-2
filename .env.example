# Set these in the process environment; never commit a private .env file.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-private-random-secret-at-least-50-characters
DJANGO_ALLOWED_HOSTS=your-domain.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
# Enable only behind a proxy you control which sets X-Forwarded-Proto.
DJANGO_TRUST_PROXY=0
DJANGO_HSTS_SECONDS=3600
# Only needed for the explicit Cloudinary upload command.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
