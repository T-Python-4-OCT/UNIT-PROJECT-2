msgstr "Asir"

msgid "عسير / اللون / الفنون"
msgstr "Asir / Color / Arts"

msgid "عسير من سلسلة Next Stop"
msgstr "Asir from the Next Stop series"

msgid "عسير والباحة"
msgstr "Asir and Al-Baha"

msgid "عصر البيوت التجارية"
msgstr "The era of commercial houses"

msgid "عطر الورد"
msgstr "Rose perfume"

