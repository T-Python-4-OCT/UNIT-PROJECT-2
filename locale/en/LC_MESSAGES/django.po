msgstr "In AlUla Governorate"

msgid "في محافظة القريات"
msgstr "In Qurayyat Governorate"

msgid "في محافظة القطيف"
msgstr "In Qatif Governorate"

msgid "في محافظة القنفذة"
msgstr "In Al-Qunfudhah Governorate"

msgid "في محافظة المخواة"
msgstr "In Al-Makhwa Governorate"

