msgid "خبز بر مقطع يتشرب المرق، ويُقدَّم مع اللحم في بعض طرقه. يرتبط بالمائدة النجرانية وبأوانٍ تقليدية مثل المدهن."
msgstr "Sliced whole wheat bread soaked in broth, and served with meat in some ways. It is associated with the Najrani table and traditional utensils such as madhan."

msgid "خبز بر مقطع يغمر بالمرق واللحم، يورده المصدر ضمن موائد مدينة نجران."
msgstr "Chopped whole wheat bread immersed in broth and meat, supplied by the source to the tables of the city of Najran."

msgid "خبز بر يمزج بالتمر والسمن، تشتهر به القصيم شتاءً."
msgstr "Whole wheat bread mixed with dates and ghee, which Qassim is famous for in winter."

msgid "خبز بر يُفتت ويُعرك ليأخذ قوامه، ثم يلتقي بالسمن والعسل. تشتهر بها عسير، وتتشارك مناطق أخرى إعدادها مع اختلاف الإضافات."
msgstr "Whole wheat bread is crumbled and kneaded to give it its texture, then mixed with ghee and honey. Asir is famous for it, and other regions share its preparation with different additions."

msgid "خبز تنور محلي تشتهر به محافظة الأحساء."
msgstr "Local tanoor bread that Al-Ahsa Governorate is famous for."

msgid "خبز مفتوت يشكل في هيئة دوائر ويقدم إلى جانب المرق في موائد المدينة."
