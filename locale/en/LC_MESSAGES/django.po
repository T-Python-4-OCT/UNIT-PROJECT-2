msgstr "In Baljurashi Governorate"

msgid "في محافظة تيماء"
msgstr "In Taima Governorate"

msgid "في محافظة جزر فرسان"
msgstr "In Farasan Islands Governorate"

msgid "في محافظة حفر الباطن"
msgstr "In Hafar Al-Batin Governorate"

msgid "في محافظة دومة الجندل"
msgstr "In Dumat al-Jandal Governorate"

msgid "في محافظة رجال ألمع"
msgstr "In Rijal Almaa Governorate"

msgid "في محافظة رفحاء"
msgstr "In Rafha Governorate"

msgid "في محافظة شرورة"
msgstr "In Sharurah Governorate"

