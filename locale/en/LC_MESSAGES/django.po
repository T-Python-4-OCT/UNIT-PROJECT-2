msgstr "What makes it unique"

msgid "تاريخها"
msgstr "Its history"

msgid "معالم تحكي"
msgstr "Landmarks with stories"

msgid "صنائع أهلها"
msgstr "Local crafts"

msgid "عمرانها"
msgstr "Its architecture"

